---
import { useT, type Lang } from '~/i18n';

interface Props {
  /** Rendered HTML of Situation, Task, Action, Result. */
  html: string[];
  metrics: { label: string; value: string }[];
  lang: Lang;
  /** Open every step (permalink page); otherwise only Situation is open. */
  allOpen?: boolean;
}
const { html, metrics, lang, allOpen = false } = Astro.props;
const t = useT(lang);
const steps = [
  { key: 's', label: t('star.situation') },
  { key: 't', label: t('star.task') },
  { key: 'a', label: t('star.action') },
  { key: 'r', label: t('star.result') },
] as const;
---

<ol class="stepper">
  {steps.map((step, i) => (
    <li class={`step step-${step.key}`}>
      <details open={allOpen || i === 0}>
        <summary>
          <span class="dot" aria-hidden="true" />
          <span class="label">{step.label}</span>
        </summary>
        <div class="content prose-step">
          <Fragment set:html={html[i]} />
          {step.key === 'r' && metrics.length > 0 && (
            <ul class="mt-3 flex flex-wrap gap-2">
              {metrics.map((m) => (
                <li class="chip chip-mint">
                  <strong class="mr-1">{m.value}</strong> {m.label}
                </li>
              ))}
            </ul>
          )}
        </div>
      </details>
    </li>
  ))}
</ol>

<style>
  .stepper {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .step {
    --c: var(--mint);
    position: relative;
    padding-left: 28px;
    border-left: 2px solid var(--c);
    margin-left: 8px;
  }
  .step-t {
    --c: var(--sky);
  }
  .step-a {
    --c: var(--butter);
  }
  /* Butter on a light background is too pale for a line: darken it with the text colour. */
  .step-a {
    border-left-color: color-mix(in srgb, var(--butter) 70%, var(--text-2));
  }
  .step-r {
    border-image: linear-gradient(var(--mint), var(--sky)) 1;
    border-left-width: 2px;
  }
  .step:last-child {
    padding-bottom: 4px;
  }
  .dot {
    position: absolute;
    left: -9px;
    top: 14px;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--c);
    box-shadow: 0 0 0 3px var(--surface);
  }
  .step-r .dot {
    background: linear-gradient(135deg, var(--mint), var(--sky));
  }
  summary {
    display: flex;
    align-items: center;
    gap: 8px;
    min-height: 44px;
    cursor: pointer;
    font-weight: 600;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '▸';
    color: var(--text-2);
    transition: transform 200ms var(--ease);
  }
  details[open] > summary::after {
    transform: rotate(90deg);
  }
  .content {
    padding-bottom: 12px;
    color: var(--text-2);
  }
  .content :global(p + p) {
    margin-top: 0.75em;
  }
  .content :global(ul) {
    padding-left: 1.25em;
    list-style: disc;
  }
</style>
