---
import { competencies, type Competency } from '~/content/competencies';
import { useT, type Lang } from '~/i18n';

interface Props {
  lang: Lang;
  /** Competencies used by at least one story. */
  present: Competency[];
}
const { lang, present } = Astro.props;
const t = useT(lang);
---

<div data-js-only class="flex flex-wrap items-center gap-x-6 gap-y-3">
  <div class="flex gap-4 text-[0.9375rem]">
    <button type="button" class="link-quiet min-h-11" data-expand="all">
      {t('star.expandAll')}
    </button>
    <button type="button" class="link-quiet min-h-11" data-expand="none">
      {t('star.collapseAll')}
    </button>
  </div>
  <div
    role="group"
    aria-label={t('star.filter')}
    class="flex flex-wrap gap-2"
    data-competency-filter
  >
    <button type="button" class="chip-btn" data-c="all" aria-pressed="true">
      {t('star.filterAll')}
    </button>
    {present.map((c) => (
      <button type="button" class="chip-btn" data-c={c} aria-pressed="false">
        {competencies[c][lang]}
      </button>
    ))}
  </div>
</div>

<style>
  .chip-btn {
    min-height: 44px;
    padding-inline: 16px;
    border-radius: 999px;
    background: var(--surface-2);
    color: var(--text);
    font-size: 0.875rem;
    font-weight: 500;
    transition: background-color 200ms var(--ease);
  }
  .chip-btn[aria-pressed='true'] {
    background: var(--sky-tint);
    box-shadow: inset 0 0 0 2px var(--sky-ink);
  }
</style>
