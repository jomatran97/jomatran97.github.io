---
import { Icon } from 'astro-icon/components';
import { competencies } from '~/content/competencies';
import { render, type Localized } from '~/lib/content';
import { headlineMetric, splitStarHtml } from '~/lib/star';
import { useT, type Lang } from '~/i18n';
import { localePath } from '~/i18n/routes';
import StarStepper from './StarStepper.astro';

interface Props {
  story: Localized<'star'>;
  lang: Lang;
}
const { story, lang } = Astro.props;
const t = useT(lang);
const d = story.data;
await render(story); // fills `story.rendered` (HTML)
const { lead, sections: html } = splitStarHtml(story.rendered?.html ?? '');
const headline = headlineMetric(d.metrics);
---

<article class="card story" data-story data-competencies={d.competencies.join(' ')} data-reveal>
  <details>
    <summary>
      <span class="block pr-12">
        <span class="title">{d.title}</span>
        <span class="question">
          <span class="sr-only">{t('star.question')}: </span>
          {d.question}
        </span>
        <span class="mt-3 flex flex-wrap gap-2">
          {d.competencies.map((c) => (
            <span class="chip chip-sky">{competencies[c][lang]}</span>
          ))}
          {headline && <span class="chip chip-mint">{headline}</span>}
          {d.sample && <span class="chip chip-butter">{t('star.sample')}</span>}
        </span>
      </span>
    </summary>
    <div class="px-6 pb-4">
      {lead && <div class="lead" set:html={lead} />}
      <StarStepper {html} metrics={d.metrics} {lang} />
    </div>
  </details>
  <a
    href={localePath(`/star/${story.slug}/`, lang)}
    class="icon-btn permalink"
    aria-label={`${t('star.permalink')}: ${d.title}`}
    title={t('star.permalink')}
  >
    <Icon name="lucide:link" size={18} />
  </a>
</article>

<style>
  .story {
    position: relative;
  }
  summary {
    padding: 20px 24px;
    cursor: pointer;
    list-style: none;
    border-radius: var(--radius-card);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .title {
    display: block;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .question {
    display: block;
    margin-top: 4px;
    color: var(--text-2);
    font-style: italic;
  }
  .lead {
    margin-bottom: 12px;
    padding: 10px 14px;
    border-radius: 12px;
    background: var(--butter-tint);
    font-size: 0.9375rem;
  }
  .permalink {
    position: absolute;
    top: 12px;
    right: 12px;
  }
</style>
