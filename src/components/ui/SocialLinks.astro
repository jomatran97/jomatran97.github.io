---
import { Icon } from 'astro-icon/components';
import { useT, type Lang } from '~/i18n';
import type { CollectionEntry } from 'astro:content';

interface Props {
  profile: CollectionEntry<'profile'>['data'];
  lang: Lang;
}
const { profile, lang } = Astro.props;
const t = useT(lang);
const links = [
  { href: `mailto:${profile.email}`, icon: 'mail', label: t('cv.email') },
  { href: `tel:${profile.phone}`, icon: 'phone', label: t('cv.phone') },
  { href: profile.socials.linkedin, icon: 'linkedin', label: t('cv.linkedin') },
  { href: profile.socials.github, icon: 'github', label: t('cv.github') },
  ...(profile.socials.x ? [{ href: profile.socials.x, icon: 'x', label: 'X' }] : []),
  ...(profile.socials.bluesky
    ? [{ href: profile.socials.bluesky, icon: 'cloud', label: 'Bluesky' }]
    : []),
];
---

<ul class="flex flex-wrap gap-1" aria-label={t('footer.social')}>
  {links.map((l) => (
    <li>
      <a
        href={l.href}
        class="icon-btn"
        aria-label={l.label}
        title={l.label}
        rel={l.href.startsWith('http') ? 'noopener' : undefined}
      >
        <Icon name={`lucide:${l.icon}`} size={22} />
      </a>
    </li>
  ))}
</ul>
