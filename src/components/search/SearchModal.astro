---
import { Icon } from 'astro-icon/components';
import { useT, type Lang } from '~/i18n';

const { lang, chromeLang } = Astro.props as { lang: Lang; chromeLang?: string };
const t = useT(lang);
---

<dialog
  id="search-dialog"
  class="search"
  aria-label={t('search.title')}
  lang={chromeLang}
  data-unavailable={t('search.unavailable')}
  data-none={t('search.noResults', { query: '{query}' })}
  data-count={t('search.count', { n: '{n}' })}
  data-type-blog={t('search.type.blog')}
  data-type-star={t('search.type.star')}
  data-type-cv={t('search.type.cv')}
  data-type-projects={t('search.type.projects')}
>
  <form method="dialog" class="box">
    <div class="field">
      <Icon name="lucide:search" size={20} />
      <input
        id="search-input"
        type="search"
        autocomplete="off"
        spellcheck="false"
        placeholder={t('search.placeholder')}
        aria-label={t('search.title')}
        aria-controls="search-results"
      />
      <button class="close" aria-label={t('search.close')}>
        Esc
      </button>
    </div>
    <p id="search-status" class="status" role="status" aria-live="polite"></p>
    <ul id="search-results" class="results"></ul>
  </form>
</dialog>

<style>
  .search {
    width: min(640px, calc(100vw - 32px));
    max-height: min(560px, calc(100vh - 96px));
    margin: 12vh auto auto;
    padding: 0;
    border: 0;
    border-radius: 20px;
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow-lg);
    overflow: hidden;
  }
  .search::backdrop {
    background: rgb(0 0 0 / 0.35);
    -webkit-backdrop-filter: blur(8px);
    backdrop-filter: blur(8px);
  }
  .box {
    display: flex;
    flex-direction: column;
    max-height: inherit;
  }
  .field {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 12px 8px 20px;
    border-bottom: 1px solid var(--border);
  }
  input {
    flex: 1;
    min-height: 44px;
    background: transparent;
    color: var(--text);
    font-size: 1.0625rem;
    outline: none;
  }
  input::placeholder {
    color: var(--text-2);
  }
  .field:focus-within {
    box-shadow: inset 0 -2px 0 var(--sky-ink);
  }
  .close {
    min-height: 44px;
    min-width: 44px;
    border-radius: 12px;
    color: var(--text-2);
    font-size: 0.8125rem;
    font-weight: 500;
  }
  .status {
    padding: 8px 20px 0;
    color: var(--text-2);
    font-size: 0.875rem;
  }
  .status:empty {
    display: none;
  }
  .results {
    list-style: none;
    margin: 0;
    padding: 8px;
    overflow-y: auto;
  }
  .results:empty {
    display: none;
  }
</style>
