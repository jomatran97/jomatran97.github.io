---
import { Icon } from 'astro-icon/components';
import { localePath, stripLang } from '~/i18n/routes';
import { useT, type Lang } from '~/i18n';
import ThemeToggle from './ThemeToggle.astro';
import LangSwitch from './LangSwitch.astro';
import MobileSheet from './MobileSheet.astro';

const {
  lang,
  switchHref,
  chromeLang,
  wide = false,
} = Astro.props as {
  lang: Lang;
  switchHref: string;
  chromeLang?: string;
  wide?: boolean;
};
const t = useT(lang);
const path = stripLang(Astro.url.pathname);
const links = (
  [
    ['/experiences/', 'nav.cv'],
    ['/projects/', 'nav.projects'],
    ['/star/', 'nav.star'],
    ['/blog/', 'nav.blog'],
  ] as const
).map(([href, key]) => ({ href, label: t(key), current: path.startsWith(href) }));
---

<header class="nav" data-nav lang={chromeLang}>
  <div class:list={['container-page bar', { wide }]}>
    <a href={localePath('/', lang)} class="brand" aria-label={t('nav.home')}>
      Ryan Parker
    </a>
    <nav aria-label={t('nav.primary')} class="links">
      {links.map((l) => (
        <a href={localePath(l.href, lang)} aria-current={l.current ? 'page' : undefined}>
          {l.label}
        </a>
      ))}
    </nav>
    <div class="tools">
      <button
        type="button"
        class="icon-btn"
        data-search-open
        aria-label={t('search.open')}
        aria-keyshortcuts="Control+K Meta+K"
        title={`${t('search.open')} (⌘K)`}
      >
        <Icon name="lucide:search" size={20} />
      </button>
      <ThemeToggle {lang} />
      <LangSwitch {lang} href={switchHref} />
      <button
        type="button"
        class="icon-btn menu"
        data-menu-button
        aria-expanded="false"
        aria-controls="mobile-sheet"
        aria-label={t('nav.menu')}
      >
        <Icon name="lucide:menu" size={22} />
      </button>
    </div>
  </div>
  <MobileSheet {lang} {links} />
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--nav-h);
    background: var(--bg);
    border-bottom: 1px solid transparent;
    transition: border-color 200ms var(--ease);
  }
  @supports (backdrop-filter: blur(1px)) or (-webkit-backdrop-filter: blur(1px)) {
    .nav {
      background: var(--nav-glass);
      -webkit-backdrop-filter: saturate(180%) blur(20px);
      backdrop-filter: saturate(180%) blur(20px);
    }
  }
  .nav[data-scrolled] {
    border-bottom-color: var(--border);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 12px;
    height: 100%;
  }
  .brand {
    min-height: 44px;
    display: inline-flex;
    align-items: center;
    color: var(--text);
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .links {
    display: none;
    flex: 1;
    gap: 4px;
  }
  .links a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 12px;
    border-radius: 999px;
    color: var(--text-2);
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .links a:hover,
  .links a[aria-current='page'] {
    color: var(--text);
    text-decoration: none;
  }
  .links a[aria-current='page'] {
    background: var(--surface-2);
  }
  .tools {
    display: flex;
    align-items: center;
    gap: 4px;
    margin-left: auto;
  }
  @media (min-width: 768px) {
    .bar {
      gap: 24px;
    }
    .links {
      display: flex;
    }
    .menu {
      display: none;
    }
    .tools {
      margin-left: 0;
    }
  }
</style>

<script>
  import '~/scripts/nav';
</script>
