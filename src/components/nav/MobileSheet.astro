---
import { localePath } from '~/i18n/routes';
import { useT, type Lang } from '~/i18n';

interface Props {
  lang: Lang;
  links: { href: string; label: string; current: boolean }[];
}
const { lang, links } = Astro.props;
const t = useT(lang);
---

<div id="mobile-sheet" class="sheet" hidden>
  <nav aria-label={t('nav.primary')}>
    <ul>
      {links.map((l) => (
        <li>
          <a href={localePath(l.href, lang)} aria-current={l.current ? 'page' : undefined}>
            {l.label}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</div>

<style>
  .sheet {
    position: fixed;
    inset: var(--nav-h) 0 0 0;
    z-index: 40;
    padding: 24px 16px;
    background: var(--bg);
    overflow-y: auto;
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  a {
    display: flex;
    align-items: center;
    min-height: 56px;
    border-bottom: 1px solid var(--border);
    color: var(--text);
    font-size: 1.75rem;
    font-weight: 600;
    letter-spacing: -0.015em;
  }
  a:hover {
    text-decoration: none;
  }
  a[aria-current='page'] {
    color: var(--mint-ink);
  }
  @media (min-width: 768px) {
    .sheet {
      display: none !important;
    }
  }
</style>
