---
import type { Localized } from '~/lib/content';
import { sortRoles } from '~/lib/cv';
import type { Lang } from '~/i18n';
import TimelineItem from './TimelineItem.astro';

interface Props {
  roles: Localized<'experience'>[];
  lang: Lang;
  stories: Record<string, number>;
}
const { roles, lang, stories } = Astro.props;
const sorted = sortRoles(roles.map((r) => ({ ...r, start: r.data.start, end: r.data.end })));
---

<ol class="list-none p-0">
  {sorted.map((role, i) => (
    <TimelineItem
      {role}
      {lang}
      index={i}
      current={!role.data.end}
      stories={stories[role.slug] ?? 0}
    />
  ))}
</ol>
