---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import { useT, type Lang } from '~/i18n';
import { localePath } from '~/i18n/routes';
import { displayUrl } from '~/lib/cv';

interface Props {
  profile: CollectionEntry<'profile'>['data'];
  lang: Lang;
}
const { profile: p, lang } = Astro.props;
const t = useT(lang);
const contacts = [
  { href: `mailto:${p.email}`, icon: 'mail', text: p.email },
  { href: `tel:${p.phone}`, icon: 'phone', text: p.phoneDisplay },
  { href: p.socials.linkedin, icon: 'linkedin', text: displayUrl(p.socials.linkedin) },
  { href: p.socials.github, icon: 'github', text: displayUrl(p.socials.github) },
];
---

<header class="page-head">
  <h1 class="text-[clamp(2.5rem,6vw,4.5rem)] tracking-[-0.025em]">{p.name}</h1>
  <p class="mt-3 text-xl font-medium">
    <strong class="font-semibold">{p.headline}</strong> — {p.tagline}
  </p>
  <p class="meta mt-2 flex items-center gap-1.5">
    <Icon name="lucide:map-pin" size={16} />
    {p.location}
  </p>
  <ul class="mt-6 flex flex-wrap gap-x-2 gap-y-1">
    {contacts.map((c) => (
      <li>
        <a
          href={c.href}
          class="inline-flex min-h-11 items-center gap-2 rounded-full pr-3 pl-2 text-text hover:bg-surface-2 hover:no-underline"
          rel={c.href.startsWith('http') ? 'noopener' : undefined}
        >
          <Icon name={`lucide:${c.icon}`} size={20} />
          <span>{c.text}</span>
        </a>
      </li>
    ))}
  </ul>
  <a href={localePath('/cv.pdf', lang)} download="Ryan-Parker-CV.pdf" class="btn btn-primary mt-6">
    <Icon name="lucide:download" size={18} />
    {t('common.download')}
  </a>
</header>
