---
import type { Localized } from '~/lib/content';
import { render } from '~/lib/content';
import { companyLabel, formatDateRange } from '~/lib/cv';
import { useT, type Lang } from '~/i18n';
import { localePath } from '~/i18n/routes';

interface Props {
  role: Localized<'experience'>;
  lang: Lang;
  current: boolean;
  stories: number;
  index: number;
}
const { role, lang, current, stories, index } = Astro.props;
const t = useT(lang);
const d = role.data;
const { Content } = await render(role);
---

<li id={role.slug} class="item" data-reveal style={`--i:${Math.min(index, 4)}`}>
  <span class:list={['dot', { current }]} aria-hidden="true"></span>
  <div class="flex flex-wrap items-baseline justify-between gap-x-4">
    <h3>{companyLabel(d.company, d.client)}</h3>
    <p class="meta">{formatDateRange(d.start, d.end, lang)}</p>
  </div>
  <p class="meta mt-1">
    {d.role} · {d.location}
  </p>
  <div class="bullets mt-4">
    <Content />
  </div>
  {d.tech.length > 0 && (
    <ul class="mt-4 flex flex-wrap gap-2" aria-label={t('common.tech')}>
      {d.tech.map((tech) => (
        <li class="chip">{tech}</li>
      ))}
    </ul>
  )}
  {stories > 0 && (
    <a href={localePath(`/star/#${role.slug}`, lang)} class="link-quiet mt-4 inline-block">
      {stories === 1 ? t('cv.story') : t('cv.stories', { n: stories })}
    </a>
  )}
</li>

<style>
  .item {
    position: relative;
    padding: 0 0 48px 32px;
    border-left: 2px solid var(--border);
    margin-left: 5px;
    scroll-margin-top: calc(var(--nav-h) + 16px);
  }
  .item:last-child {
    padding-bottom: 0;
    border-left-color: transparent;
  }
  .dot {
    position: absolute;
    left: -7px;
    top: 6px;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--mint);
  }
  .dot.current {
    box-shadow: 0 0 0 3px var(--sky);
  }
</style>
