---
import { Icon } from 'astro-icon/components';
import { Image } from 'astro:assets';
import type { Localized } from '~/lib/content';
import { render } from '~/lib/content';
import { companyLabel, formatDateRange } from '~/lib/cv';
import { useT, type Lang } from '~/i18n';
import { localePath } from '~/i18n/routes';

interface Props {
  project: Localized<'projects'>;
  lang: Lang;
  /** Role (experience entry) this project belongs to, when `role` is set. */
  role?: Localized<'experience'>;
  index: number;
}
const { project, lang, role, index } = Astro.props;
const t = useT(lang);
const d = project.data;
const { Content } = await render(project);
const tint = { personal: 'chip-mint', work: 'chip-sky', 'open-source': 'chip-butter' }[d.kind];
---

<article
  class:list={['card project', { featured: d.featured }]}
  data-project={project.slug}
  data-kind={d.kind}
  data-reveal
  style={`--i:${Math.min(index, 5)}`}
>
  {d.image && <Image src={d.image} alt="" width={640} height={360} loading="lazy" class="cover" />}
  <div class="body">
    <div class="flex items-start justify-between gap-3">
      <h2 id={project.slug} class="title text-2xl">
        {d.title}
      </h2>
      <span class={`chip ${tint}`}>{t(`projects.kind.${d.kind}`)}</span>
    </div>
    <p class="meta mt-1">{d.subtitle}</p>
    <p class="meta mt-1">{formatDateRange(d.start, d.end, lang)}</p>
    <p class="mt-3">{d.summary}</p>
    {d.tech.length > 0 && (
      <ul class="mt-4 flex flex-wrap gap-2" aria-label={t('common.tech')}>
        {d.tech.map((x) => (
          <li class="chip">{x}</li>
        ))}
      </ul>
    )}
    <p class="mt-4 flex flex-wrap gap-x-5 gap-y-1 text-[0.9375rem]">
      {d.repo && (
        <a href={d.repo} rel="noopener" target="_blank" class="link-quiet">
          {t('projects.repo')} ↗
        </a>
      )}
      {d.demo && (
        <a href={d.demo} rel="noopener" target="_blank" class="link-quiet">
          {t('projects.live')} ↗
        </a>
      )}
      {role && (
        <a href={localePath(`/experiences/#${role.slug}`, lang)} class="link-quiet">
          {t('common.at', { company: companyLabel(role.data.company, role.data.client) })}
        </a>
      )}
    </p>
    <details class="mt-4">
      <summary>
        {t('projects.details')}
        <Icon name="lucide:chevron-down" size={18} class="chev" />
      </summary>
      <div class="bullets pt-3">
        <Content />
      </div>
    </details>
  </div>
</article>

<style>
  .project {
    overflow: hidden;
  }
  .title {
    scroll-margin-top: calc(var(--nav-h) + 96px);
  }
  .body {
    padding: 24px;
  }
  .cover {
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
  }
  @media (min-width: 640px) {
    .featured {
      grid-column: span 2;
    }
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
    cursor: pointer;
    font-weight: 600;
    list-style: none;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  details[open] :global(.chev) {
    transform: rotate(180deg);
  }
  :global(.chev) {
    transition: transform 200ms var(--ease);
  }
  details {
    interpolate-size: allow-keywords;
  }
  details::details-content {
    height: 0;
    overflow: hidden;
    transition:
      height 300ms var(--ease),
      content-visibility 300ms allow-discrete;
  }
  details[open]::details-content {
    height: auto;
  }
  @media (prefers-reduced-motion: reduce) {
    details::details-content,
    :global(.chev) {
      transition: none;
    }
  }
</style>
