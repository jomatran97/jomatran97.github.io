---
import { useT, type Lang } from '~/i18n';

interface Props {
  lang: Lang;
  counts: Record<string, number>;
  total: number;
}
const { lang, counts, total } = Astro.props;
const t = useT(lang);
const kinds = (['personal', 'work', 'open-source'] as const).filter((k) => counts[k] > 0);
const options = [{ kind: 'all', n: total }, ...kinds.map((k) => ({ kind: k, n: counts[k] }))];
---

<div class="flex flex-wrap items-center gap-4" data-js-only>
  {kinds.length > 1 && (
    <div class="segmented" role="group" aria-label={t('projects.filter')} data-kind-filter>
      {options.map((o) => (
        <button type="button" data-kind={o.kind} aria-pressed={o.kind === 'all' ? 'true' : 'false'}>
          {t(`projects.kind.${o.kind}` as 'projects.kind.all')}
          <span class="count">{o.n}</span>
        </button>
      ))}
    </div>
  )}
  <div class="flex gap-4 text-[0.9375rem]">
    <button type="button" class="link-quiet min-h-11" data-expand="all">
      {t('projects.expandAll')}
    </button>
    <button type="button" class="link-quiet min-h-11" data-expand="none">
      {t('projects.collapseAll')}
    </button>
  </div>
</div>

<style>
  .segmented {
    display: inline-flex;
    padding: 3px;
    border-radius: 999px;
    background: var(--surface-2);
  }
  .segmented button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding-inline: 16px;
    border-radius: 999px;
    color: var(--text-2);
    font-size: 0.9375rem;
    font-weight: 500;
    transition:
      background-color 200ms var(--ease),
      color 200ms var(--ease);
  }
  .segmented button[aria-pressed='true'] {
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow);
  }
  .count {
    font-size: 0.8125rem;
    color: var(--text-2);
  }
</style>
