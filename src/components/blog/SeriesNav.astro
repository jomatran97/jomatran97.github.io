---
import { useT, type Lang } from '~/i18n';
import { localePath } from '~/i18n/routes';

interface Part {
  part: number;
  title: string;
  post?: { slug: string };
}
interface Props {
  lang: Lang;
  prev?: Part;
  next?: Part;
}
const { lang, prev, next } = Astro.props;
const t = useT(lang);
---

{(prev || next) && (
  <nav class="grid gap-4 sm:grid-cols-2" aria-label={t('series.title')}>
    {prev?.post ? (
      <a class="card nav-card" rel="prev" href={localePath(`/blog/${prev.post.slug}/`, lang)}>
        {t('series.prev', { n: prev.part, title: prev.title })}
      </a>
    ) : (
      <span />
    )}
    {next?.post && (
      <a
        class="card nav-card text-right sm:col-start-2"
        rel="next"
        href={localePath(`/blog/${next.post.slug}/`, lang)}
      >
        {t('series.next', { n: next.part, title: next.title })}
      </a>
    )}
  </nav>
)}

<style>
  .nav-card {
    display: block;
    padding: 16px 20px;
    color: var(--text);
    font-weight: 600;
  }
  .nav-card:hover {
    text-decoration: none;
    box-shadow: var(--shadow-lg);
  }
</style>
