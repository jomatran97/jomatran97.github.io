---
interface Props {
  headings: { depth: number; slug: string; text: string }[];
}
const { headings } = Astro.props;
---

<ol>
  {headings.map((h) => (
    <li class={h.depth === 3 ? 'sub' : undefined}>
      <a href={`#${h.slug}`}>{h.text}</a>
    </li>
  ))}
</ol>

<style>
  ol {
    list-style: none;
    margin: 0;
    padding: 0 0 12px;
    display: grid;
    gap: 2px;
  }
  .sub {
    padding-left: 16px;
  }
  a {
    display: block;
    padding-block: 6px;
    color: var(--text-2);
  }
  a:hover,
  a[aria-current='location'] {
    color: var(--text);
    text-decoration: none;
  }
  a[aria-current='location'] {
    font-weight: 600;
    color: var(--mint-ink);
  }
</style>
