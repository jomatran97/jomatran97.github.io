---
import { useT, type Lang } from '~/i18n';
import { localePath } from '~/i18n/routes';

interface Props {
  lang: Lang;
  part: number;
  title: string;
  description?: string;
  post?: { slug: string };
  minutes?: number;
}
const { lang, part, title, description, post, minutes } = Astro.props;
const t = useT(lang);
---

<li class:list={['card p-6', { soon: !post }]} data-reveal>
  <p class="meta">{t('series.part', { n: part })}</p>
  <h2 class="mt-1 text-2xl">
    {post ? <a href={localePath(`/blog/${post.slug}/`, lang)}>{title}</a> : title}
  </h2>
  {description && <p class="mt-2 text-text-2">{description}</p>}
  <p class="meta mt-3 flex flex-wrap items-center gap-3">
    {post ? (
      <span>{t('blog.readingTime', { n: minutes ?? 1 })}</span>
    ) : (
      <span class="chip">{t('series.soon')}</span>
    )}
  </p>
</li>

<style>
  h2 a {
    color: var(--text);
  }
</style>
