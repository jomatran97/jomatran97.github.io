---
import { formatDate } from '~/lib/format';
import type { Post } from '~/lib/blog-content';
import { useT, type Lang } from '~/i18n';
import { localePath } from '~/i18n/routes';

interface Props {
  post: Post;
  lang: Lang;
  /** Title of the series this post belongs to, when it is in one. */
  seriesTitle?: string;
}
const { post, lang, seriesTitle } = Astro.props;
const t = useT(lang);
const d = post.data;
---

<li class="card p-6" data-reveal>
  {seriesTitle && d.series && (
    <a class="chip chip-mint mb-3" href={localePath(`/blog/series/${d.series}/`, lang)}>
      {t('series.chip', { title: seriesTitle, n: d.seriesPart ?? 0 })}
    </a>
  )}
  <h2 class="text-2xl">
    <a href={localePath(`/blog/${post.slug}/`, lang)}>{d.title}</a>
  </h2>
  <p class="mt-2 text-text-2">{d.description}</p>
  <p class="meta mt-3 flex flex-wrap gap-x-3">
    <time datetime={d.pubDate.toISOString()}>{formatDate(d.pubDate, lang)}</time>
    <span>{t('blog.readingTime', { n: post.minutes })}</span>
    {d.draft && <span class="chip chip-butter">{t('blog.draft')}</span>}
  </p>
  {d.tags.length > 0 && (
    <ul class="mt-3 flex flex-wrap gap-2">
      {d.tags.map((tag) => (
        <li>
          <a class="chip" href={localePath(`/blog/tags/${tag}/`, lang)}>
            {tag}
          </a>
        </li>
      ))}
    </ul>
  )}
</li>

<style>
  h2 a {
    color: var(--text);
  }
  .chip:hover {
    text-decoration: none;
  }
</style>
