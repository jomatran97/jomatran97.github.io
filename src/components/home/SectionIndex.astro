---
import { useT, type Lang } from '~/i18n';

interface Props {
  lang: Lang;
  items: { id: string; label: string }[];
}
const { lang, items } = Astro.props;
const t = useT(lang);
---

<nav class="index" aria-label={t('home.onThisPage')} data-section-index data-fit="1">
  <p class="meta mb-2">{t('home.onThisPage')}</p>
  <ul>
    {items.map((i, n) => (
      <li>
        <a href={`#${i.id}`} aria-current={n === 0 ? 'location' : undefined}>
          {i.label}
        </a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .index {
    display: none;
  }
  @media (min-width: 1280px) {
    .index {
      display: block;
    }
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    border-left: 2px solid var(--border);
  }
  a {
    display: block;
    padding: 6px 14px;
    margin-left: -2px;
    border-left: 2px solid transparent;
    color: var(--text-2);
    font-size: 0.9375rem;
  }
  a:hover,
  a[aria-current='location'] {
    color: var(--text);
    text-decoration: none;
  }
  a[aria-current='location'] {
    border-left-color: var(--mint-ink);
    font-weight: 600;
  }
</style>

<script>
  import '~/scripts/section-index';
</script>
