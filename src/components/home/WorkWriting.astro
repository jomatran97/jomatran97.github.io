---
import type { Post } from '~/lib/blog-content';
import type { Localized } from '~/lib/content';
import { formatDate } from '~/lib/format';
import { useT, type Lang } from '~/i18n';
import { localePath } from '~/i18n/routes';
import { workEmptyStates } from '~/lib/home';
import CertificationRow from './CertificationRow.astro';

interface Props {
  lang: Lang;
  project?: Localized<'projects'>;
  posts: Post[];
  certs: Localized<'certifications'>[];
  seriesTitle: (id?: string) => string | undefined;
}
const { lang, project, posts, certs, seriesTitle } = Astro.props;
const t = useT(lang);
const tint = { personal: 'chip-mint', work: 'chip-sky', 'open-source': 'chip-butter' };
const tech = project?.data.tech ?? [];
const empty = workEmptyStates({
  hasProject: !!project,
  postCount: posts.length,
  certCount: certs.length,
});
---

<div class="work" data-block>
  <article class="card col project" data-reveal style="--i:0">
    <h3>{t('home.work.project')}</h3>
    {project ? (
      <>
        <p class="mt-4">
          <span class={`chip ${tint[project.data.kind]}`}>
            {t(`projects.kind.${project.data.kind}`)}
          </span>
        </p>
        <p class="item mt-3">
          <a href={localePath(`/projects/#${project.slug}`, lang)}>{project.data.title}</a>
        </p>
        <p class="meta mt-1">{project.data.subtitle}</p>
        <p class="mt-3 text-text-2">{project.data.summary}</p>
        <ul class="mt-4 flex flex-wrap gap-2" aria-label={t('common.tech')}>
          {tech.slice(0, 6).map((x) => (
            <li class="chip">{x}</li>
          ))}
          {tech.length > 6 && (
            <li class="chip">{t('home.work.moreTech', { n: tech.length - 6 })}</li>
          )}
        </ul>
        <p class="mt-4">
          <a href={localePath('/projects/', lang)} class="link-quiet">
            {t('home.work.projects')}
          </a>
        </p>
      </>
    ) : (
      empty.project && <p class="mt-4 text-text-2">{t(empty.project)}</p>
    )}
  </article>

  <article class="card col" data-reveal style="--i:1">
    <h3>{t('home.work.writing')}</h3>
    {posts.length > 0 ? (
      <>
        <ul class="mt-4 grid gap-4">
          {posts.map((post) => {
            const series = seriesTitle(post.data.series);
            return (
              <li>
                <p class="item">
                  <a href={localePath(`/blog/${post.slug}/`, lang)}>{post.data.title}</a>
                </p>
                <p class="meta mt-1 flex flex-wrap gap-x-3">
                  <time datetime={post.data.pubDate.toISOString()}>
                    {formatDate(post.data.pubDate, lang)}
                  </time>
                  <span>{t('blog.readingTime', { n: post.minutes })}</span>
                </p>
                {series && (
                  <a
                    class="chip chip-mint mt-2 hover:no-underline"
                    href={localePath(`/blog/series/${post.data.series}/`, lang)}
                  >
                    {t('series.chip', { title: series, n: post.data.seriesPart ?? 0 })}
                  </a>
                )}
              </li>
            );
          })}
        </ul>
        <p class="mt-4">
          <a href={localePath('/blog/', lang)} class="link-quiet">
            {t('home.posts.all')}
          </a>
        </p>
      </>
    ) : (
      empty.posts && <p class="mt-4 text-text-2">{t(empty.posts)}</p>
    )}
  </article>

  <article id="certifications" class="card col certs" data-reveal style="--i:2">
    <h3>{t('home.certs.title')}</h3>
    {certs.length > 0 ? (
      <ul class="mt-4 grid gap-5">
        {certs.map((cert, i) => (
          <CertificationRow {cert} {lang} index={i} />
        ))}
      </ul>
    ) : (
      empty.certs && <p class="mt-4 text-text-2">{t(empty.certs)}</p>
    )}
  </article>
</div>

<style>
  .work {
    display: grid;
    gap: 24px;
    align-items: start;
  }
  .col {
    padding: 24px;
  }
  .item {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .item a {
    color: var(--text);
  }
  @media (min-width: 640px) {
    .work {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .project {
      grid-column: 1 / -1;
    }
  }
  @media (min-width: 1024px) {
    .work {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
    .project {
      grid-column: auto;
    }
  }
</style>
