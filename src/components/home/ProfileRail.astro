---
import { Icon } from 'astro-icon/components';
import type { CollectionEntry } from 'astro:content';
import type { Localized } from '~/lib/content';
import { companyLabel, formatCvDate } from '~/lib/cv';
import { useT, type Lang } from '~/i18n';
import { localePath } from '~/i18n/routes';
import SocialLinks from '~/components/ui/SocialLinks.astro';
import SectionIndex from './SectionIndex.astro';

interface Props {
  lang: Lang;
  profile: CollectionEntry<'profile'>['data'];
  role?: Localized<'experience'>;
  index: { id: string; label: string }[];
}
const { lang, profile: p, role, index } = Astro.props;
const t = useT(lang);
---

<aside class="rail" aria-label={t('home.profile')}>
  <div class="identity">
    <h1 class="name">{p.name}</h1>
    <p class="headline">
      {p.headline} — {p.tagline}
    </p>
    <p class="positioning" data-fit="3">
      {t('home.subline')}
    </p>
    <p class="meta loc" data-fit="4">
      <Icon name="lucide:map-pin" size={16} />
      {p.location}
    </p>
    <div class="pills">
      <a href={localePath('/experiences/', lang)} class="btn btn-primary">
        {t('home.viewCv')}
      </a>
      <a href={localePath('/cv.pdf', lang)} download="Ryan-Parker-CV.pdf" class="btn btn-secondary">
        <Icon name="lucide:download" size={18} />
        {t('common.download')}
      </a>
    </div>
    <a href={localePath('/blog/', lang)} class="link-quiet read">
      {t('home.readBlog')}
    </a>
  </div>

  <div class="side">
    <dl class="stats">
      <div class="tile-num">
        <dt class="meta">{t('home.years')}</dt>
        <dd class="num">{p.yearsOfExperience}</dd>
      </div>
      {role && (
        <div class="tile-role">
          <dt class="meta">{t('home.currentRole')}</dt>
          <dd class="role">{role.data.role}</dd>
          <dd class="meta">
            {companyLabel(role.data.company, role.data.client)} ·{' '}
            {t('home.since', { date: formatCvDate(role.data.start, lang) })}
          </dd>
        </div>
      )}
      {p.headlineMetric && (
        <div class="tile-num">
          <dt class="meta">{p.headlineMetric.label}</dt>
          <dd class="num">{p.headlineMetric.value}</dd>
        </div>
      )}
    </dl>

    <ul class="langs" data-fit="2">
      {p.spokenLanguages.map((l) => (
        <li>
          <strong class="font-semibold">{l.language}</strong> — {l.proficiency}
        </li>
      ))}
    </ul>

    <SocialLinks profile={p} {lang} />
    <SectionIndex {lang} items={index} />
  </div>
</aside>

<style>
  .rail {
    display: grid;
    gap: 24px;
    padding-block: 40px 8px;
  }
  .name {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    letter-spacing: -0.025em;
  }
  .headline {
    margin-top: 12px;
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.35;
  }
  .positioning {
    margin-top: 8px;
    color: var(--text-2);
  }
  .loc {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 12px;
  }
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 20px;
  }
  /* Quiet link directly under the pills; 44px tap target without a visual indent. */
  .read {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-top: 2px;
    font-size: 0.9375rem;
  }
  .side {
    display: grid;
    gap: 20px;
    align-content: start;
  }
  .stats {
    display: grid;
    gap: 12px;
    margin: 0;
  }
  .stats > div {
    display: flex;
    flex-direction: column;
    padding: 14px 16px;
    border-radius: 18px;
    background: var(--surface);
    box-shadow: var(--shadow);
  }
  .stats dd {
    margin: 0;
  }
  /* Number first, label second, in every layout. The role tile reads label, title, company. */
  .tile-num .num {
    order: 1;
  }
  .tile-num dt {
    order: 2;
  }
  .num {
    font-size: clamp(1.5rem, 3vw, 2.25rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.15;
  }
  .role {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .langs {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px;
    color: var(--text-2);
    font-size: 0.9375rem;
  }
  .langs strong {
    color: var(--text);
  }
  @media (min-width: 480px) {
    .stats {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
  /* 1024-1279px: two-column profile header. */
  @media (min-width: 1024px) {
    .rail {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 48px;
      align-items: start;
      padding-block: 64px 24px;
    }
  }
  /* >= 1280px: sticky 360px rail beside the canvas. It must never clip: the blocks marked
     data-fit are hidden by priority (index, languages, positioning, location) when the viewport
     is too short. The height breakpoints below match the measured rail height in EN and VI;
     rail-fit.ts re-checks at run time (fonts, zoom, longer translations). */
  @media (min-width: 1280px) {
    .rail {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
      padding-block: 0;
      align-self: start;
    }
    /* Sticky only when the full rail (435px, the smallest it gets) fits beside the nav. In
       shorter windows it scrolls with the page instead, so nothing is ever unreachable. */
    @media (min-height: 551px) {
      .rail {
        position: sticky;
        top: calc(var(--nav-h) + 32px);
        max-height: calc(100vh - var(--nav-h) - 64px);
        overflow-y: auto;
        scrollbar-width: none;
      }
      .rail::-webkit-scrollbar {
        display: none;
      }
    }
    .name {
      font-size: 2.5rem;
    }
    .headline {
      margin-top: 6px;
      font-size: 1.0625rem;
    }
    .positioning {
      margin-top: 4px;
      font-size: 0.9375rem;
    }
    .loc {
      margin-top: 8px;
    }
    .pills {
      margin-top: 12px;
      gap: 8px;
    }
    /* Keep both pills on one row in the 360px rail ("View experiences" is the longer label). */
    .pills :global(.btn) {
      padding-inline: 14px;
    }
    .side {
      gap: 14px;
    }
    .stats {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px;
    }
    .stats > div {
      padding: 8px 14px;
    }
    .num {
      font-size: 1.75rem;
    }
    .tile-role {
      grid-column: 1 / -1;
      order: 3;
    }
    /* Measured rail height (EN and VI): 744px with everything, 556 without the index, 518 without
       the languages, 466 without the positioning line, 435 without the location. The rail has
       100vh - 116px, so each block hides below its measured height + 116 (plus 3px). Below 551px
       the rail is static (above), so every block shows. */
    @media (min-height: 551px) and (max-height: 863px) {
      .rail :global([data-fit='1']) {
        display: none;
      }
    }
    @media (min-height: 551px) and (max-height: 674px) {
      .rail :global([data-fit='2']) {
        display: none;
      }
    }
    @media (min-height: 551px) and (max-height: 636px) {
      .rail :global([data-fit='3']) {
        display: none;
      }
    }
    @media (min-height: 551px) and (max-height: 584px) {
      .rail :global([data-fit='4']) {
        display: none;
      }
    }
  }
</style>

<script>
  import '~/scripts/rail-fit';
</script>
