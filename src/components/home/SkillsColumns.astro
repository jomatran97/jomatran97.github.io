---
import type { Localized } from '~/lib/content';
import { layoutSkills } from '~/lib/balance';
import SkillCard from './SkillCard.astro';

interface Props {
  skills: Localized<'skills'>[];
}
const { skills } = Astro.props;
const sorted = [...skills].sort((a, b) => a.data.order - b.data.order);
const cards = sorted.map((skill, index) => ({
  skill,
  index,
  chips: skill.data.items.reduce((n, i) => n + 1 + (i.children?.length ?? 0), 0),
  descriptionLength: skill.data.description.length,
  wide: skill.data.size !== '1x1',
}));
const bands = layoutSkills(cards);
---

<!-- Build-time balanced layout (spec §4.1.3). DOM order is the `order` field; the columns are
     visual only: narrow runs use CSS columns, wide cards sit beside a stack of narrow cards. -->
<div class="skills" data-block>
  {bands.map((band) =>
    band.kind === 'flow' ? (
      <div class="flow">
        {band.items.map((c) => (
          <SkillCard skill={c.skill} index={c.index} />
        ))}
      </div>
    ) : (
      <div class:list={['wide-band', { flip: band.flip }]}>
        <SkillCard skill={band.wide.skill} index={band.wide.index} />
        {band.side.length > 0 && (
          <div class="stack">
            {band.side.map((c) => (
              <SkillCard skill={c.skill} index={c.index} />
            ))}
          </div>
        )}
      </div>
    ),
  )}
</div>

<style>
  /* Below 1024px the bands are flattened: cards fill a 1 or 2 column grid in DOM order. */
  .skills {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 24px;
    align-items: start;
  }
  .flow,
  .wide-band,
  .stack {
    display: contents;
  }
  @media (min-width: 640px) {
    .skills {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  /* From 1024px: wide cards sit beside a stack of narrow cards; other runs balance into 3 columns.
     Every card carries a 24px bottom margin and `.skills` pulls the last one back. */
  @media (min-width: 1024px) {
    .skills {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
      margin-bottom: -24px;
    }
    .skills :global(.skill-card) {
      margin-bottom: 24px;
    }
    .flow {
      display: block;
      columns: 3;
      column-gap: 24px;
    }
    .wide-band {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 24px;
      align-items: start;
      margin-bottom: 24px;
    }
    .stack {
      display: grid;
      gap: 24px;
      align-content: start;
    }
    .wide-band :global(.skill-card) {
      margin-bottom: 0;
    }
    .wide-band > :global(.skill-card:first-child) {
      grid-column: 1 / span 2;
    }
    .wide-band > .stack {
      grid-column: 3;
    }
    .wide-band.flip > :global(.skill-card:first-child) {
      grid-column: 2 / span 2;
      grid-row: 1;
    }
    .wide-band.flip > .stack {
      grid-column: 1;
      grid-row: 1;
    }
  }
</style>
