---
import { competencies } from '~/content/competencies';
import { render, type Localized } from '~/lib/content';
import { storyLayout } from '~/lib/home';
import { headlineMetric, splitStarHtml } from '~/lib/star';
import { useT, type Lang } from '~/i18n';
import { localePath } from '~/i18n/routes';

interface Props {
  stories: Localized<'star'>[];
  lang: Lang;
}
const { stories, lang } = Astro.props;
const t = useT(lang);
const layout = storyLayout(stories.length);
const single = layout.wide;
// With one story the card is wide, so it also shows the question and the Situation summary.
let situation = '';
if (single) {
  await render(stories[0]);
  situation = splitStarHtml(stories[0].rendered?.html ?? '').sections[0];
}
---

<ul class={`stories ${layout.className}`} data-block>
  {stories.map((s, i) => {
    const headline = headlineMetric(s.data.metrics);
    return (
      <li class="card p-6" data-reveal style={`--i:${i}`}>
        <h3>
          <a href={localePath(`/star/${s.slug}/`, lang)} class="text-text">
            {s.data.title}
          </a>
        </h3>
        {single && <p class="mt-2 text-text-2 italic">{s.data.question}</p>}
        {single && situation && (
          <div class="mt-3 text-text-2">
            <p class="meta">{t('home.stories.situation')}</p>
            <div set:html={situation} />
          </div>
        )}
        <ul class="mt-3 flex flex-wrap gap-2">
          {s.data.competencies.map((c) => (
            <li class="chip chip-sky">{competencies[c][lang]}</li>
          ))}
          {headline && <li class="chip chip-mint">{headline}</li>}
          {s.data.sample && <li class="chip chip-butter">{t('star.sample')}</li>}
        </ul>
      </li>
    );
  })}
</ul>

<style>
  .stories {
    display: grid;
    gap: 24px;
    align-items: start;
    grid-template-columns: minmax(0, 1fr);
  }
  @media (min-width: 640px) {
    .stories:not(.n-1) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (min-width: 1024px) {
    .stories.n-3 {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
