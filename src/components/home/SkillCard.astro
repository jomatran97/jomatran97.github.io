---
import { Icon } from 'astro-icon/components';
import type { Localized } from '~/lib/content';

interface Props {
  skill: Localized<'skills'>;
  index: number;
}
const { skill, index } = Astro.props;
const d = skill.data;
---

<article
  class={`skill-card tint-${d.tint}`}
  data-skill-card
  data-reveal
  style={`--i:${Math.min(index, 5)}`}
>
  <div class="flex items-center gap-3">
    <Icon name={`lucide:${d.icon}`} size={28} class="shrink-0" data-skill-icon />
    <h3>{d.group}</h3>
  </div>
  <p class="mt-3 text-text-2">{d.description}</p>
  <ul class="mt-4 flex flex-wrap items-center gap-2" aria-label={d.group}>
    {d.items.map((item) => (
      <>
        <li class="chip">{item.name}</li>
        {item.children?.map((child) => (
          <li class="chip chip-sm">{child}</li>
        ))}
      </>
    ))}
  </ul>
</article>

<style>
  .skill-card {
    padding: 24px;
    border-radius: var(--radius-bento);
    background: var(--surface);
    box-shadow: var(--shadow);
    transition:
      scale 200ms var(--ease),
      box-shadow 200ms var(--ease);
    break-inside: avoid;
  }
  @media (hover: hover) and (pointer: fine) {
    .skill-card:hover {
      scale: 1.01;
      box-shadow: var(--shadow-lg);
    }
  }
</style>
