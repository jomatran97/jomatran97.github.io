---
import { useT, type Lang } from '~/i18n';
import SocialLinks from '~/components/ui/SocialLinks.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
  lang: Lang;
  profile: CollectionEntry<'profile'>['data'];
}
const { lang, profile } = Astro.props;
const t = useT(lang);
---

<div class="band-contact" data-block>
  <div>
    <h2 id="contact-title">{t('home.contact.title')}</h2>
    <p class="mt-2 text-xl text-text-2">{t('home.contact.text')}</p>
  </div>
  <div class="cta">
    <a href={`mailto:${profile.email}`} class="btn btn-primary">
      {t('home.contact.email')}
    </a>
    <div class="social">
      <SocialLinks {profile} {lang} />
    </div>
  </div>
</div>

<style>
  .band-contact {
    display: grid;
    justify-items: center;
    gap: 24px;
    text-align: center;
  }
  .band-contact p {
    max-width: 52ch;
  }
  .cta {
    display: grid;
    justify-items: center;
    gap: 16px;
  }
  /* The rail already carries the contact icons on wide screens: compact one-line band. */
  @media (min-width: 1280px) {
    .band-contact {
      grid-template-columns: 1fr auto;
      justify-items: start;
      align-items: center;
      text-align: left;
    }
    .band-contact p {
      max-width: none;
      font-size: 1.0625rem;
      margin-top: 4px;
    }
    .social {
      display: none;
    }
  }
</style>
