---
import { Image } from 'astro:assets';
import type { Localized } from '~/lib/content';
import { useT, type Lang } from '~/i18n';

interface Props {
  cert: Localized<'certifications'>;
  lang: Lang;
  index: number;
}
const { cert, lang, index } = Astro.props;
const t = useT(lang);
const d = cert.data;
const tint = ['mint', 'sky', 'butter'][index % 3];
---

<li class="row" data-cert-card>
  {d.badge ? (
    <Image src={d.badge} alt="" width={40} height={40} class="badge" />
  ) : (
    <span class={`badge monogram tint-${tint}`} aria-hidden="true" data-monogram>
      {d.monogram}
    </span>
  )}
  <div class="min-w-0">
    <p class="name">{d.name}</p>
    <p class="meta mt-0.5">{d.issuer}</p>
    <p class="mt-2 flex flex-wrap items-center gap-3">
      <span class="chip">{d.year}</span>
      {d.credentialUrl && (
        <a
          href={d.credentialUrl}
          target="_blank"
          rel="noopener"
          class="link-quiet"
          aria-label={`${t('home.certs.verify')}: ${d.name}`}
        >
          {t('home.certs.verify')} ↗
        </a>
      )}
    </p>
  </div>
</li>

<style>
  .row {
    display: flex;
    align-items: flex-start;
    gap: 14px;
  }
  .badge {
    flex: none;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    object-fit: cover;
  }
  .monogram {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text);
  }
  .name {
    font-weight: 600;
    line-height: 1.35;
  }
</style>
