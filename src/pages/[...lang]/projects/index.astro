---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import KindFilter from '~/components/projects/KindFilter.astro';
import ProjectCard from '~/components/projects/ProjectCard.astro';
import { getLocalized } from '~/lib/content';
import { sortProjects } from '~/lib/cv';
import { getLang, langStaticPaths } from '~/i18n/routes';
import { useT } from '~/i18n';

export const getStaticPaths = (() => langStaticPaths()) satisfies GetStaticPaths;

const lang = getLang(Astro.params.lang);
const t = useT(lang);
const { items, fallback } = await getLocalized('projects', lang);
const { items: roles, fallback: rolesFallback } = await getLocalized('experience', lang);
const projects = sortProjects(
  items.map((p) => ({ ...p, start: p.data.start, end: p.data.end, featured: p.data.featured })),
);

const counts: Record<string, number> = {};
for (const p of projects) counts[p.data.kind] = (counts[p.data.kind] ?? 0) + 1;

const roleFor = (slug?: string) => {
  if (!slug) return undefined;
  const role = roles.find((r) => r.slug === slug);
  if (!role) throw new Error(`Project role "${slug}" does not match any experience entry.`);
  return role;
};
---

<BaseLayout
  title={t('projects.title')}
  description={t('projects.description')}
  {lang}
  searchType="projects"
  fallback={fallback || (rolesFallback && projects.some((p) => p.data.role))}
>
  <div class="container-page">
    <header class="page-head">
      <h1>{t('projects.title')}</h1>
      <p class="mt-3 text-xl text-text-2">{t('projects.subline')}</p>
      <div class="mt-8">
        <KindFilter {lang} {counts} total={projects.length} />
      </div>
    </header>

    <div class="grid items-start gap-6 pb-8 sm:grid-cols-2 lg:grid-cols-3">
      {projects.map((p, i) => (
        <ProjectCard project={p} {lang} role={roleFor(p.data.role)} index={i} />
      ))}
    </div>

    <div id="projects-empty" class="py-16 text-center" hidden>
      <p class="text-xl">{t('projects.empty')}</p>
      <button type="button" class="btn btn-secondary mt-4" data-reset>
        {t('projects.reset')}
      </button>
    </div>
  </div>
</BaseLayout>

<script>
  import '~/scripts/projects';
</script>
