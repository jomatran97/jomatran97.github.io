---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import CvHeader from '~/components/cv/CvHeader.astro';
import Timeline from '~/components/cv/Timeline.astro';
import { getLocalized, getProfile, render } from '~/lib/content';
import { getLang, langStaticPaths, localePath } from '~/i18n/routes';
import { personLd } from '~/lib/jsonld';
import { useT } from '~/i18n';

export const getStaticPaths = (() => langStaticPaths()) satisfies GetStaticPaths;

const lang = getLang(Astro.params.lang);
const t = useT(lang);
const { entry, data: profile, fallback: profileFallback } = await getProfile(lang);
const { items: roles, fallback: rolesFallback } = await getLocalized('experience', lang);
const { Content: Summary } = await render(entry);

// Same fallback rule as everywhere else: untranslated stories still count.
const { items: starStories } = await getLocalized('star', lang);
const stories: Record<string, number> = {};
for (const s of starStories) {
  if (s.data.role) stories[s.data.role] = (stories[s.data.role] ?? 0) + 1;
}
const jsonLd = personLd(profile, new URL(localePath('/experiences/', lang), Astro.site).href, lang);
---

<BaseLayout
  title={t('cv.title')}
  description={t('cv.description')}
  {lang}
  fallback={profileFallback || rolesFallback}
  searchType="cv"
  {jsonLd}
>
  <div class="container-page">
    <CvHeader {profile} {lang} />

    <section aria-labelledby="summary" class="mt-8" data-reveal>
      <h2 id="summary" class="mb-4">
        {t('cv.summary')}
      </h2>
      <div class="max-w-[68ch] text-[1.1875rem] leading-relaxed [&_strong]:font-semibold">
        <Summary />
      </div>
      <p class="mt-4 flex flex-wrap gap-x-6">
        <a href={localePath('/projects/', lang)} class="link-quiet">
          {t('cv.projectsLink')}
        </a>
        <a href={localePath('/#skills', lang)} class="link-quiet">
          {t('cv.skillsLink')}
        </a>
      </p>
    </section>

    <section aria-labelledby="experience" class="mt-20 pb-8">
      <h2 id="experience" class="mb-10">
        {t('cv.experience')}
      </h2>
      <Timeline {roles} {lang} {stories} />
    </section>
  </div>
</BaseLayout>
