---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostCard from '~/components/blog/PostCard.astro';
import { countTags } from '~/lib/blog';
import { getPosts, getSeriesList } from '~/lib/blog-content';
import { getLang, langStaticPaths, localePath } from '~/i18n/routes';
import { useT } from '~/i18n';

export const getStaticPaths = (async () => {
  const paths = [];
  for (const { params } of langStaticPaths()) {
    const { posts } = await getPosts(getLang(params.lang));
    for (const { tag } of countTags(posts)) paths.push({ params: { ...params, tag } });
  }
  return paths;
}) satisfies GetStaticPaths;

const lang = getLang(Astro.params.lang);
const t = useT(lang);
const { tag } = Astro.params;
const { posts: all, fallback } = await getPosts(lang);
const posts = all.filter((p) => p.data.tags.includes(tag!));
const { series } = await getSeriesList(lang);
const seriesTitle = (id?: string) => series.find((s) => s.slug === id)?.data.title;
const title = t('blog.tagTitle', { tag: tag! });
---

<BaseLayout {title} description={title} {lang} {fallback} noSearch>
  <div class="container-page">
    <header class="page-head">
      <h1>{title}</h1>
      <p class="meta mt-3">
        {posts.length === 1 ? t('blog.post') : t('blog.posts', { n: posts.length })}
      </p>
      <p class="mt-3">
        <a href={localePath('/blog/tags/', lang)} class="link-quiet">
          ← {t('blog.allTags')}
        </a>
      </p>
    </header>
    <ul class="grid max-w-[68ch] gap-5 pb-8">
      {posts.map((post) => (
        <PostCard {post} {lang} seriesTitle={seriesTitle(post.data.series)} />
      ))}
    </ul>
  </div>
</BaseLayout>
