---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '~/layouts/BaseLayout.astro';
import PostCard from '~/components/blog/PostCard.astro';
import { countTags } from '~/lib/blog';
import { getPosts, getSeriesList } from '~/lib/blog-content';
import { getLang, langStaticPaths, localePath } from '~/i18n/routes';
import { useT } from '~/i18n';

export const getStaticPaths = (() => langStaticPaths()) satisfies GetStaticPaths;

const lang = getLang(Astro.params.lang);
const t = useT(lang);
const { posts, fallback } = await getPosts(lang);
const { series } = await getSeriesList(lang);
const seriesTitle = (id?: string) => series.find((s) => s.slug === id)?.data.title;
const tags = countTags(posts);
---

<BaseLayout title={t('blog.title')} description={t('blog.description')} {lang} {fallback}>
  <div class="container-page">
    <header class="page-head">
      <h1>{t('blog.title')}</h1>
      <p class="mt-3 text-xl text-text-2">{t('blog.subline')}</p>
      {tags.length > 0 && (
        <ul class="mt-6 flex flex-wrap gap-2" aria-label={t('blog.tags')}>
          {tags.map(({ tag, count }) => (
            <li>
              <a class="chip hover:no-underline" href={localePath(`/blog/tags/${tag}/`, lang)}>
                {tag} · {count}
              </a>
            </li>
          ))}
          <li>
            <a class="chip chip-sky hover:no-underline" href={localePath('/blog/tags/', lang)}>
              {t('blog.allTags')}
            </a>
          </li>
        </ul>
      )}
    </header>
    {posts.length ? (
      <ul class="grid max-w-[68ch] gap-5 pb-8">
        {posts.map((post) => (
          <PostCard {post} {lang} seriesTitle={seriesTitle(post.data.series)} />
        ))}
      </ul>
    ) : (
      <p class="pb-8 text-xl text-text-2">{t('blog.noPosts')}</p>
    )}
  </div>
</BaseLayout>
