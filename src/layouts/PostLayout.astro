---
import '~/styles/prose.css';
import newsreaderLatin from '@fontsource-variable/newsreader/files/newsreader-latin-wght-normal.woff2?url';
import newsreaderVietnamese from '@fontsource-variable/newsreader/files/newsreader-vietnamese-wght-normal.woff2?url';
import BaseLayout from './BaseLayout.astro';
import SeriesBox from '~/components/blog/SeriesBox.astro';
import SeriesNav from '~/components/blog/SeriesNav.astro';
import Toc from '~/components/blog/Toc.astro';
import { seriesNeighbors } from '~/lib/blog';
import type { Post } from '~/lib/blog-content';
import { formatDate } from '~/lib/format';
import { blogPostingLd } from '~/lib/jsonld';
import { getProfile } from '~/lib/content';
import { useT, type Lang } from '~/i18n';
import { localePath, switchTarget } from '~/i18n/routes';

interface Props {
  post: Post;
  lang: Lang;
  minutes: number;
  headings: { depth: number; slug: string; text: string }[];
  series?: {
    slug: string;
    title: string;
    parts: { part: number; title: string; post?: { slug: string } }[];
  };
  /** Older and newer posts, used when the post is not part of a series. */
  prev?: Post;
  next?: Post;
}
const { post, lang, minutes, headings, series, prev, next } = Astro.props;
const t = useT(lang);
const d = post.data;
const { data: profile } = await getProfile(lang);
const postUrl = new URL(localePath(`/blog/${post.slug}/`, lang), Astro.site).href;
const jsonLd = blogPostingLd(d, {
  url: postUrl,
  image: new URL('/og-default.png', Astro.site).href,
  author: profile.name,
  authorUrl: new URL(localePath('/', lang), Astro.site).href,
  lang: post.contentLang,
});
const neighbors = series && d.seriesPart ? seriesNeighbors(series.parts, d.seriesPart) : undefined;
---

<BaseLayout
  title={d.title}
  description={d.description}
  {lang}
  fallback={post.contentLang !== lang}
  langs={post.available}
  switchHref={switchTarget(post.available, lang, `/blog/${post.slug}/`, '/blog/')}
  ogType="article"
  searchType="blog"
  {jsonLd}
>
  <Fragment slot="head">
    <link rel="preload" as="font" type="font/woff2" href={newsreaderLatin} crossorigin />
    {post.contentLang === 'vi' && (
      <link rel="preload" as="font" type="font/woff2" href={newsreaderVietnamese} crossorigin />
    )}
  </Fragment>
  <article class="container-page post">
    <header class="head">
      <h1 class="mt-12">{d.title}</h1>
      <p class="mt-4 text-xl text-text-2">{d.description}</p>
      <p class="meta mt-4 flex flex-wrap gap-x-3">
        <time datetime={d.pubDate.toISOString()}>{formatDate(d.pubDate, lang)}</time>
        {d.updatedDate && (
          <time datetime={d.updatedDate.toISOString()}>
            {t('blog.updated', { date: formatDate(d.updatedDate, lang) })}
          </time>
        )}
        <span>{t('blog.readingTime', { n: minutes })}</span>
      </p>
      {d.tags.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-2" aria-label={t('blog.tags')}>
          {d.tags.map((tag) => (
            <li>
              <a class="chip hover:no-underline" href={localePath(`/blog/tags/${tag}/`, lang)}>
                {tag}
              </a>
            </li>
          ))}
        </ul>
      )}
      {series && d.seriesPart && (
        <SeriesBox {lang} {series} parts={series.parts} current={d.seriesPart} />
      )}
    </header>

    <Toc {lang} {headings} />

    <div class="prose body">
      <slot />
    </div>

    <footer class="foot">
      {neighbors ? (
        <SeriesNav {lang} prev={neighbors.prev} next={neighbors.next} />
      ) : (
        (prev || next) && (
          <nav class="grid gap-4 sm:grid-cols-2" aria-label={t('blog.back')}>
            {prev ? (
              <a class="card nav-card" rel="prev" href={localePath(`/blog/${prev.slug}/`, lang)}>
                ← {prev.data.title}
              </a>
            ) : (
              <span />
            )}
            {next && (
              <a
                class="card nav-card text-right"
                rel="next"
                href={localePath(`/blog/${next.slug}/`, lang)}
              >
                {next.data.title} →
              </a>
            )}
          </nav>
        )
      )}
      {d.tags.length > 0 && (
        <ul class="mt-8 flex flex-wrap items-center gap-2" aria-label={t('blog.tags')}>
          {d.tags.map((tag) => (
            <li>
              <a class="chip hover:no-underline" href={localePath(`/blog/tags/${tag}/`, lang)}>
                {tag}
              </a>
            </li>
          ))}
        </ul>
      )}
      <p class="mt-8">
        <a href={localePath('/blog/', lang)} class="link-quiet">
          ← {t('blog.back')}
        </a>
      </p>
    </footer>
  </article>
</BaseLayout>

<style>
  .post {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas: 'head' 'tocn' 'body' 'foot';
    padding-bottom: 32px;
  }
  .head,
  .body,
  .foot {
    width: 100%;
    max-width: 68ch;
    margin-inline: auto;
  }
  .head {
    grid-area: head;
  }
  .body {
    grid-area: body;
  }
  .foot {
    grid-area: foot;
    margin-top: 64px;
  }
  @media (min-width: 1024px) {
    .post {
      grid-template-columns: minmax(0, 68ch) 240px;
      grid-template-areas: 'head .' 'body toc' 'foot .';
      justify-content: center;
      column-gap: 56px;
    }
    .head,
    .body,
    .foot {
      margin-inline: 0;
    }
  }
  .nav-card {
    display: block;
    padding: 16px 20px;
    color: var(--text);
    font-weight: 600;
  }
  .nav-card:hover {
    text-decoration: none;
    box-shadow: var(--shadow-lg);
  }
</style>

<script>
  import '~/scripts/toc';
</script>
