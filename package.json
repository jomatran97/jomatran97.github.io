    "check": "astro check",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:pdf": "tsx scripts/test-pdf.ts",
    "test:e2e": "playwright test",
    "lhci": "lhci",
    "verify": "pnpm lint && pnpm format:check && pnpm check && pnpm test && pnpm build && pnpm test:pdf && pnpm test:budget && pnpm test:e2e",
    "test:budget": "tsx scripts/js-budget.ts"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.5",
