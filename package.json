    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/newsreader": "^5.3.0",
    "@iconify-json/lucide": "^1.2.148",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.4.3",
    "astro-icon": "^1.2.0",
    "pagefind": "^1.5.2",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@axe-core/playwright": "^4.14.0",
